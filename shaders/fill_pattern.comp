#version 450

// Bring-up shader for the headless compute path.
//
// Writes a pattern that is a pure function of pixel coordinate, so the expected
// output can be computed independently on the CPU and compared exactly. A
// gradient alone would not do: it is symmetric enough that transposed axes,
// wrong row stride, or a half-dispatched image can all still look plausible.
// This deliberately encodes x and y differently and leaves a constant in the
// blue channel, so those mistakes produce a mismatch rather than a near-miss.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D output_image;

layout(push_constant) uniform Push {
    uint width;
    uint height;
} push;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;

    // Dispatches are rounded up to whole workgroups, so the edges of an image
    // whose size is not a multiple of the workgroup must not be written.
    if (pixel.x >= push.width || pixel.y >= push.height) {
        return;
    }

    vec4 colour = vec4(
        float(pixel.x % 256u) / 255.0,
        float(pixel.y % 256u) / 255.0,
        float((pixel.x + pixel.y) % 256u) / 255.0,
        1.0);

    imageStore(output_image, ivec2(pixel), colour);
}
